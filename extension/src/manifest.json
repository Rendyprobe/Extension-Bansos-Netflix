{
  "manifest_version": 3,
  "name": "Bansos Netflix",
  "version": "1.0.1",
  "description": "Browser extension untuk generate Netflix token dan mengelola bahan secara aman",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bansos Netflix"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://bansos-netflix-api.25051204307.workers.dev/*"
  ]
}
