{
  "manifest_version": 3,
  "name": "Bansos Netflix",
  "version": "1.0.0",
  "description": "Browser extension untuk generate Netflix token dan mengelola bahan secara aman",
  "icons": {
    "16": "public/icon16.png",
    "48": "public/icon48.png",
    "128": "public/icon128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Bansos Netflix"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://localhost:5000/*",
    "https://api.yourdomain.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  }
}
